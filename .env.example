# ==========================================
# Modular Multi-Agent AI Framework API Keys
# ==========================================
# Copy this file to .env and add your keys.
# .env is in .gitignore so your keys are NEVER committed to GitHub!

# Groq (Lightning Fast - Free Tier: https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# NVIDIA NIM (Free Tier: https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here

# Google Gemini (Free Tier: https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
